{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "npmClient": "yarn",
  "useNx": true,
  "version": "independent",
  "packages": [
    "packages/*"
  ],
  "command": {
    "version": {
      "allowBranch": ["main", "sapp-76-react-js-sdk"],
      "conventionalCommits": true,
      "createRelease": "github",
      "message": "chore(release): publish %s"
    },
    "publish": {
      "registry": "https://registry.npmjs.org/",
      "npmClient": "npm"
    }
  }
}